NODE_ENV=production
PORT=3000
DATABASE_URL=
# Small-deployment defaults reserve capacity through scheduler serialization;
# these bounds fail fast instead of waiting forever for a checked-out client.
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECTION_TIMEOUT_MS=2000
READINESS_TIMEOUT_MS=2500

# LINE Messaging API / LINE Login / LIFF
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
LIFF_ID_CENTER_ADMIN=
LIFF_ID_FAMILY=
LIFF_ID_REGISTER=
LIFF_ID_SYSTEM_ADMIN=
LIFF_ID_PHARMACIST=

# ผู้ดูแลระบบ — ใช้ค่าสุ่มยาวและเก็บเป็น Secret เท่านั้น
ADMIN_API_KEY=

# Exact Family/Pharmacist LIFF origins allowed for REST CORS and WebSocket handshake.
# Separate multiple trusted origins with commas; no wildcard or URL path.
ALLOWED_ORIGINS=https://phimor-liff.onrender.com

# Care2Go และ AI
CARE2GO_GROUP_BIND_CODE=
GEMINI_API_KEY=
AI_NAME_MATCH_THRESHOLD=0.82

# นโยบายระบบ
REQUIRE_STAFF_APPROVAL=true
REQUIRE_CARE2GO_OPS_BINDING=true
MEDICAL_IMAGE_RETENTION_DAYS=90
INVITE_EXPIRY_DAYS=30
CARD_EXPIRY_HOURS=24
CARD_REMINDER_HOURS=2
IMAGE_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_5_MINUTES=300
# Authenticated external clients use separate shared PostgreSQL windows.
INTEGRATION_RATE_LIMIT_PER_MINUTE=120
LEGACY_CENTER_API_RATE_LIMIT_PER_MINUTE=120
CARE2GO_UNAVAILABLE_DEADLINE_HOURS=12

# Existing optional runtime variables (documented here; behavior is unchanged)
PUBLIC_LIFF_BASE_URL=https://phimor-liff.onrender.com
PUBLIC_BACKEND_URL=https://phimor-backend.onrender.com
PDF_DOWNLOAD_SECRET=
LINE_VERIFY_TIMEOUT_MS=5000
ALLOW_INSECURE_LINE_HEADER=false
ALLOW_UNSIGNED_LINE_WEBHOOK=false
STAGING_MODE=false
STAGING_CLOCK_OFFSET_MINUTES=0

# Ordinary AI stays on Gemini until a separately reviewed provider cutover.
# Pharmacist Assistant and Clinical Research use dedicated providers while ordinary flows stay unchanged.
AI_PROVIDER=gemini
AI_PROVIDER_PHARMACIST=openai
AI_PROVIDER_CLINICAL_RESEARCH=openai
OPENAI_API_KEY=
AI_MODEL_DOCUMENT=gpt-5.6-luna
AI_MODEL_EXPLANATION=gpt-5.6-terra
AI_MODEL_PHARMACIST=gpt-5.6-terra
AI_MODEL_CLINICAL_RESEARCH=gpt-5.6-sol
# Optional explicit Gemini models. Blank keeps existing model discovery.
GEMINI_MODEL_DOCUMENT=
GEMINI_MODEL_EXPLANATION=
GEMINI_MODEL_PHARMACIST=
GEMINI_MODEL_CLINICAL_RESEARCH=
AI_REASONING_DOCUMENT=low
AI_REASONING_EXPLANATION=medium
AI_REASONING_PHARMACIST=medium
AI_REASONING_CLINICAL_RESEARCH=high
# Optional comma-separated allowlist for de-identified clinical web research.
OPENAI_CLINICAL_ALLOWED_DOMAINS=
AI_TIMEOUT_MS=15000
AI_TIMEOUT_PHARMACIST_MS=45000
AI_TIMEOUT_CLINICAL_RESEARCH_MS=90000
AI_MAX_RETRIES=1

# PHIMOR Plus server-side feature flags — all Plus capabilities default off.
PLUS_ENABLED=false
PLUS_INTERNAL_ENTITLEMENT_ONLY=true
# Enable only with PLUS_INTERNAL_ENTITLEMENT_ONLY=false and verified Omise settings.
# Plus V1 is 59 THB / 30 days and manual renewal only.
PLUS_PAYMENT_ENABLED=false
PLUS_AI_EXPLANATION_ENABLED=false
PLUS_MEDICATION_DIFF_ENABLED=false
PLUS_PHARMACIST_ESCALATION_ENABLED=false
PLUS_RATE_LIMIT_PER_5_MINUTES=10

# PHIMOR Pharmacist Consultation — Foundation defaults are closed/internal only.
CONSULTATION_ENABLED=false
CONSULTATION_INTERNAL_ONLY=true
# Comma-separated verified LINE user IDs for controlled Family internal testing.
CONSULTATION_INTERNAL_LINE_USER_IDS=
CONSULTATION_PRICE_MINOR=10000
CONSULTATION_CURRENCY=THB
CONSULTATION_DURATION_MINUTES=1440
CONSULTATION_POLL_SECONDS=5
CONSULTATION_MAX_MESSAGE_CHARS=4000
CONSULTATION_PAYMENT_PROVIDER=
CONSULTATION_PAYMENT_TEST_MODE=true
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=
OMISE_TIMEOUT_MS=15000
# Leave blank until the approved consultation terms are versioned.
CONSULTATION_TERMS_VERSION=
CONSULTATION_CHECKOUT_ATTEMPTS_PER_10_MINUTES=3
CONSULTATION_MESSAGE_SENDS_PER_MINUTE=10
CONSULTATION_PHARMACIST_ACCEPTS_PER_MINUTE=10
CONSULTATION_ASSISTANT_REQUESTS_PER_10_MINUTES=5
# Production target. Set false for the immediate Clinical Research kill switch.
PHARMACIST_AI_RESEARCH_ENABLED=true
PHARMACIST_AI_RESEARCH_MODE=controlled_live
# Used only by deidentified_pilot; ignored by controlled_live.
PHARMACIST_AI_RESEARCH_PILOT_USERS=
CLINICAL_RESEARCH_REQUESTS_PER_10_MINUTES=3
# HMAC secret for 60-second, case-bound WebSocket tickets. Generate a distinct
# random value (minimum 32 characters); never reuse LINE, Omise, Gemini or integration secrets.
CONSULTATION_REALTIME_TICKET_SECRET=
# Optional dedicated exact-origin allowlist for consultation WebSocket upgrades.
# If blank, the gateway uses ALLOWED_ORIGINS. Never use wildcard/substring values.
CONSULTATION_REALTIME_ALLOWED_ORIGINS=https://phimor-liff.onrender.com
